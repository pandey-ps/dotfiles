[Desktop Entry]
Name=imv
GenericName=Image viewer
Comment=Fast Image Viewer
Exec=sh -c 'if [ -f "$1" ]; then imv -n "$1" "$(dirname "$1")"; else imv "$@"; fi' -- %f
NoDisplay=true
Terminal=false
Type=Application
Categories=Graphics;2DGraphics;Viewer;
MimeType=image/x-farbfeld;image/tiff;image/tiff-fx;image/png;image/x-png;image/jpeg;image/jpg;image/pjpeg;image/svg+xml;image/gif;image/bmp;image/x-bmp;image/heif;image/avif;image/jxl;image/webp;image/qoi
Icon=multimedia-photo-viewer
Keywords=photo;picture;
