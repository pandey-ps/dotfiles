{
	"layer": "bottom",
	"position": "top",
	"height": 32,
	"spacing": 0,

	"tooltip": false,

	"margin-top": 0,
	"margin-left": 12,
	"margin-right": 12,

	"modules-left": [
		"custom/spacing",
		"custom/workspaces", "ext/workspaces"
	],

	"modules-right": [
		"custom/time","custom/clock",
		"custom/volume", "wireplumber",
		"custom/battery", "battery",
		"custom/display",
		"custom/wifi", "network", "custom/btop",
		"tray",
		"custom/spacing"
	],

	"ext/workspaces": {
		"format": "{icon}",
		"on-click": "activate",
		"all-outputs": true,
		"format-icons": {
			"1": "first",
			"2": "second",
			"3": "third",
			"4": "fourth",
			"5": "fifth",
			"6": "sixth",
			"7": "seventh",
			"8": "eigth",
			"9": "ninth",
			"10": "tenth"
		}
	},
	"custom/workspaces": {
		"tooltip": false,
		"format": "workspaces"
	},
	"custom/volume": {
		"tooltip": false,
		"format": "sound",
		"on-click": "~/.config/waybar/scripts/audio-menu.sh"
	},
	"custom/battery": {
		"tooltip": false,
		"format": "battery",
		"on-click": "~/.config/waybar/scripts/power-menu.sh"
	},
	"battery": {
		"format": "{capacity}%",
		"tooltip": false,
		"on-click": "~/.config/waybar/scripts/power-menu.sh",
		"events": {
			"on-discharging-10": "notify-send -t 60000 'connect a charger!'"
		}
	},
	"custom/wifi": {
		"tooltip": false,
		"format": "wifi",
		"on-click": "~/.config/waybar/scripts/wifi-menu.sh"
	},
	"custom/display": {
		"tooltip": false,
		"format": "display",
		"on-click": "~/.config/waybar/scripts/display-menu.sh"
	},
	"custom/btop": {
		"tooltip": false,
		"format": "btop",
		"on-click": "alacritty --title btop -e btop"
	},
	"custom/time": {
		"tooltip": false,
		"format": "time"
	},
	"custom/spacing": {
		"tooltip": false,
		"format": " "
	},
	"custom/clock": {
		"tooltip": false,
		"format": "{}",
		"interval": 10,
		"signal": 8,
		"exec": "~/.config/waybar/scripts/clock.sh",
		"on-click": "~/.config/waybar/scripts/clock.sh toggle"
	},
	"wireplumber": {
		"format": "{volume}%",
		"format-muted": "muted",
		"on-click": "~/.config/waybar/scripts/audio-menu.sh",
		"tooltip": false,
		"scroll-step": 5.0
	},
	"network": {
		"format-wifi": "connected",
		"format-ethernet": "wired",
		"format-disconnected": "offline",
		"tooltip": false,
		"on-click": "~/.config/waybar/scripts/wifi-menu.sh",
		"interval": 5
	},
	"tray": {
		"icon-size": 16,
		"spacing": 8
	}
}
